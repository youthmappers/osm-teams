# Required: Secret used to encrypt NextAuth.js session tokens and cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Required: OAuth client credentials from https://auth.mapping.team/clients
# Create a new app with Redirect URI: http://127.0.0.1:3000/api/auth/callback/osm-teams
OSM_TEAMS_CLIENT_ID=
OSM_TEAMS_CLIENT_SECRET=

# Required for the Hydra OAuth login flow (OSM authentication)
OSM_CONSUMER_KEY=
OSM_CONSUMER_SECRET=
